# Local demonstration only. The application does not load this file automatically.
# Export these settings in the shell used to start the backend.
DEMO_MODE=true
SESSION_SECURE=false
DATABASE_PATH=./data/permitsnj.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
